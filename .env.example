# Lo scheletro si avvia anche senza questo file e senza credenziali.
# Copiare eventualmente in .env.local. I segnaposto NON sono valori validi.

# PUBBLICHE: incluse nel bundle browser da Next.js. Mai usare chiavi admin.
# URL del progetto Supabase (oppure http://127.0.0.1:54321 per lo stack locale).
NEXT_PUBLIC_SUPABASE_URL=INSERIRE_URL_SUPABASE
# Chiave publishable sb_publishable_...; il locale supporta anche la chiave anon JWT.
# Non inserire secret key, service_role, password database o access token CLI.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=INSERIRE_CHIAVE_PUBBLICA_SUPABASE

# SERVER: eventuale chiave Groq, opzionale e NON utilizzata nella fase 1.
# Nessun modello selezionato e nessuna chiamata AI implementata.
# Non aggiungere mai il prefisso NEXT_PUBLIC_ a questa variabile.
# GROQ_API_KEY=INSERIRE_CHIAVE_GROQ_SOLO_QUANDO_NECESSARIA
